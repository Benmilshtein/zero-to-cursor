# ----------------------------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AI Coach (optional — hosted mode)
# ----------------------------------------------------------------------------
# When NEXT_PUBLIC_HOSTED_AI_ENABLED=true, the server-side proxy at /api/ai
# is enabled and uses the keys below. Otherwise users must paste their own
# key (BYOK).
NEXT_PUBLIC_HOSTED_AI_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-IP requests/day for the hosted proxy (only used if hosted AI enabled)
HOSTED_AI_DAILY_LIMIT=50
